{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/11f6517780a502512a3467645074be447cb0369e/dcp.schema.json",
  "enabled": true,
  "autoUpdate": false,
  "debug": false,
  "pruneNotification": "minimal",
  "compress": {
    "permission": "ask",
    "protectUserMessages": true
  },
  "strategies": {
    "deduplication": { "enabled": true },
    "purgeErrors": { "enabled": true, "turns": 4 }
  }
}
